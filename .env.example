# ==========================================
# DriveManager - Environment Configuration
# Copy this file to .env (or run scripts\setup.ps1, which does it for you).
# IMPORTANT: wrap values containing '$' in SINGLE quotes (Argon2 hashes do).
# ==========================================

# Application
APP_NAME=DriveManager
APP_ENV=production
APP_PORT=8000
APP_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
APP_ENCRYPTION_KEY=replace_with_a_valid_fernet_key
TZ=Asia/Jakarta

# Local application login (create the hash with scripts\setup.ps1)
APP_USERNAME=admin
APP_PASSWORD_HASH='replace_with_argon2_password_hash'

# Session cookies. Set COOKIE_SECURE=true only when serving over HTTPS.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
# Extra browser origins allowed to call the API (comma separated), e.g. https://drive.home.arpa
ALLOWED_ORIGINS=

# Optional HTTPS on the LAN (see docs/DOCKER.md and scripts\make-cert.ps1)
ENABLE_TLS=false
TLS_PORT=8443

# Database (do not change unless you know why)
DATABASE_URL=sqlite:////data/drive_manager.db

# Google OAuth Web Application credentials (see docs/GOOGLE_OAUTH.md)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google Drive API
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive

# Background worker
WORKER_ENABLED=true
SYNC_INTERVAL_MINUTES=5
QUOTA_REFRESH_INTERVAL_MINUTES=5
UPLOAD_CONCURRENCY=2
UPLOAD_CHUNK_MB=8
STAGING_RETENTION_HOURS=72

# Runtime directories inside containers
STAGING_DIR=/staging
LOG_DIR=/logs
